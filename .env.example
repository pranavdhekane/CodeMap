# CodeMap Mode Configuration
# -------------------------------------------------------------
# RUN_LOCAL=true  -> Runs CodeMap strictly offline on your local machine.
#                    No Supabase connection, no login, no sign-up required.
#                    Browser opens straight into the dashboard/workspace.
#
# RUN_LOCAL=false -> Runs CodeMap in cloud mode with Supabase auth
#                    and cloud storage (requires backend/.env Supabase keys).
# -------------------------------------------------------------
RUN_LOCAL=false